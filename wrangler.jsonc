{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ongato-serverless",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-16",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],

	"vars": {
		"R2_PUBLIC_URL": "https://cdn.ongato.com.br",
		"ENVIRONMENT": "production",
		"CORS_ALLOWED_ORIGINS": "https://ongato.com.br,https://www.ongato.com.br",
		"STRIPE_SUCCESS_URL":"https://ongato.com.br/pagamento/sucesso",
		"STRIPE_CANCEL_URL": "https://ongato.com.br/pagamento/cancelado"
	},

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ongato-db",
			"database_id": "bc0d876f-c6dd-4b8d-8bd2-aa15b3a65341",
			"migrations_dir": "drizzle"
		}
	],

	"r2_buckets": [
		{
			"binding": "IMAGES_BUCKET",
			"bucket_name": "ongato-images"
		}
	],

	"ratelimits": [
		{
			"name": "GLOBAL_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 100,
				"period": 60
			}
		},
		{
			"name": "LOGIN_RATE_LIMITER",
			"namespace_id": "1002",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	]
}
